  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "View your restaurant dashboard",
      "url": "/dashboard",
      "icons": [
        {
          "src": "/icons/swadeshi-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Point of Sale",
      "short_name": "POS",
      "description": "Open Point of Sale",
      "url": "/pos",
      "icons": [
        {
          "src": "/icons/swadeshi-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
