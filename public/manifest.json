  "protocol_handlers": [
    {
      "protocol": "web+swadeshi",
      "url": "/dashboard?ref=%s"
    }
  ],
  "share_target": {
    "action": "/dashboard",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "widgets": [
    {
      "name": "Swadeshi Status",
      "short_name": "Status",
      "description": "Quick access to restaurant status",
      "tag": "status",
      "template": "status-widget",
      "ms_ac_template": "widgets/status.json",
      "data": "widgets/status-data.json",
      "type": "application/json",
      "screenshots": []
    }
  ],
  "note_taking": {
    "new_note_url": "/order-management"
  },
