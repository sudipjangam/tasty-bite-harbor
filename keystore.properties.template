# ─────────────────────────────────────────────────────────────────────────────
# Swadeshi Solutions — Local Gradle Signing Properties Template
# ─────────────────────────────────────────────────────────────────────────────
#
# USAGE:
#   Copy this file to ONE of these locations (NOT inside the project repo):
#     Option A (recommended): ~/.gradle/gradle.properties
#     Option B (CI):          Set as environment variables (KEYSTORE_PASSWORD, etc.)
#
# DO NOT commit the filled-in values to git.
# The actual values are stored in the team password manager (ask the project lead).
#
# ─────────────────────────────────────────────────────────────────────────────

# Path to the release keystore file
KEYSTORE_PATH=android/app/release-key.keystore

# Keystore and key passwords (get from password manager)
KEYSTORE_PASSWORD=YOUR_KEYSTORE_PASSWORD_HERE
KEY_ALIAS=release
KEY_PASSWORD=YOUR_KEY_PASSWORD_HERE
